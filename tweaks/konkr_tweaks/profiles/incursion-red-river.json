{
 "appid": 2116120,
 "name": "Incursion Red River",
 "experimental": true,
 "notes": {
  "es": "Unreal Engine 5 con DirectX 12 (no uses -d3d11: a muchos les impide arrancar). Edita GameUserSettings.ini y Engine.ini en AppData/Local/Test_C. En la Konkr lo que más pesa es la iluminación Lumen y las sombras virtuales: el perfil las quita en todos los modos y limita la memoria de texturas a 1 GB, porque la RAM es compartida. Si no arranca, prueba Proton Experimental o la versión más nueva de Proton que tengas.",
  "en": "Unreal Engine 5 on DirectX 12 (don't use -d3d11: it stops the game launching for many people). Edits GameUserSettings.ini and Engine.ini in AppData/Local/Test_C. On the Konkr the heaviest parts are Lumen lighting and virtual shadows: the profile turns them off in every mode and caps texture memory at 1 GB, because RAM is shared. If it won't launch, try Proton Experimental or the newest Proton you have."
 },
 "files": {
  "gus": {
   "path": "{appdata_local}/Test_C/Saved/Config/Windows/GameUserSettings.ini",
   "type": "ini"
  },
  "engine": {
   "path": "{appdata_local}/Test_C/Saved/Config/Windows/Engine.ini",
   "type": "ini",
   "create": true
  }
 },
 "require": [
  "gus"
 ],
 "launch": {
  "fex": "fast",
  "ntsync": true
 },
 "resolution": {
  "file": "gus",
  "section": "/Script/Engine.GameUserSettings",
  "width": [
   "ResolutionSizeX",
   "LastUserConfirmedResolutionSizeX"
  ],
  "height": [
   "ResolutionSizeY",
   "LastUserConfirmedResolutionSizeY"
  ],
  "choices": [
   "960x540",
   "1280x720",
   "1600x900",
   "1920x1080"
  ]
 },
 "fps_limit": {
  "file": "gus",
  "on": {
   "/Script/Engine.GameUserSettings/FrameRateLimit": "{fps}.000000"
  },
  "off": {
   "/Script/Engine.GameUserSettings/FrameRateLimit": "0.000000"
  }
 },
 "presets": {
  "lowest": {
   "gus": {
    "ScalabilityGroups": {
     "sg.ResolutionQuality": "100",
     "sg.ViewDistanceQuality": "0",
     "sg.AntiAliasingQuality": "0",
     "sg.ShadowQuality": "0",
     "sg.GlobalIlluminationQuality": "0",
     "sg.ReflectionQuality": "0",
     "sg.PostProcessQuality": "0",
     "sg.TextureQuality": "1",
     "sg.EffectsQuality": "0",
     "sg.FoliageQuality": "0",
     "sg.ShadingQuality": "0",
     "sg.LandscapeQuality": "0"
    },
    "/Script/Engine.GameUserSettings": {
     "bUseVSync": "False",
     "bUseDynamicResolution": "False"
    }
   },
   "engine": {
    "SystemSettings": {
     "r.Shadow.Virtual.Enable": "0",
     "r.MotionBlurQuality": "0",
     "r.DefaultFeature.MotionBlur": "0",
     "r.Streaming.PoolSize": "1024",
     "r.DynamicGlobalIlluminationMethod": "0",
     "r.ReflectionMethod": "0",
     "r.AntiAliasingMethod": "1",
     "r.VolumetricFog": "0",
     "r.DepthOfFieldQuality": "0",
     "r.SSR.Quality": "0",
     "r.AmbientOcclusionLevels": "0",
     "r.Shadow.MaxResolution": "512",
     "r.Shadow.DistanceScale": "0.6",
     "foliage.DensityScale": "0.5",
     "grass.DensityScale": "0.5"
    }
   }
  },
  "balanced": {
   "gus": {
    "ScalabilityGroups": {
     "sg.ResolutionQuality": "100",
     "sg.ViewDistanceQuality": "1",
     "sg.AntiAliasingQuality": "2",
     "sg.ShadowQuality": "1",
     "sg.GlobalIlluminationQuality": "1",
     "sg.ReflectionQuality": "1",
     "sg.PostProcessQuality": "1",
     "sg.TextureQuality": "2",
     "sg.EffectsQuality": "1",
     "sg.FoliageQuality": "1",
     "sg.ShadingQuality": "1",
     "sg.LandscapeQuality": "1"
    },
    "/Script/Engine.GameUserSettings": {
     "bUseVSync": "False",
     "bUseDynamicResolution": "False"
    }
   },
   "engine": {
    "SystemSettings": {
     "r.Shadow.Virtual.Enable": "0",
     "r.MotionBlurQuality": "0",
     "r.DefaultFeature.MotionBlur": "0",
     "r.Streaming.PoolSize": "1024",
     "r.DynamicGlobalIlluminationMethod": "0",
     "r.ReflectionMethod": "2",
     "r.AntiAliasingMethod": "2",
     "r.VolumetricFog": "0",
     "r.DepthOfFieldQuality": null,
     "r.SSR.Quality": "1",
     "r.AmbientOcclusionLevels": "1",
     "r.Shadow.MaxResolution": "1024",
     "r.Shadow.DistanceScale": "0.8",
     "foliage.DensityScale": "0.75",
     "grass.DensityScale": "0.75"
    }
   }
  },
  "quality": {
   "gus": {
    "ScalabilityGroups": {
     "sg.ResolutionQuality": "100",
     "sg.ViewDistanceQuality": "2",
     "sg.AntiAliasingQuality": "2",
     "sg.ShadowQuality": "2",
     "sg.GlobalIlluminationQuality": "1",
     "sg.ReflectionQuality": "2",
     "sg.PostProcessQuality": "2",
     "sg.TextureQuality": "2",
     "sg.EffectsQuality": "2",
     "sg.FoliageQuality": "2",
     "sg.ShadingQuality": "2",
     "sg.LandscapeQuality": "2"
    },
    "/Script/Engine.GameUserSettings": {
     "bUseVSync": "False",
     "bUseDynamicResolution": "False"
    }
   },
   "engine": {
    "SystemSettings": {
     "r.Shadow.Virtual.Enable": "0",
     "r.MotionBlurQuality": "0",
     "r.DefaultFeature.MotionBlur": "0",
     "r.Streaming.PoolSize": "1024",
     "r.DynamicGlobalIlluminationMethod": "0",
     "r.ReflectionMethod": "2",
     "r.AntiAliasingMethod": null,
     "r.VolumetricFog": null,
     "r.DepthOfFieldQuality": null,
     "r.SSR.Quality": null,
     "r.AmbientOcclusionLevels": null,
     "r.Shadow.MaxResolution": "2048",
     "r.Shadow.DistanceScale": null,
     "foliage.DensityScale": null,
     "grass.DensityScale": null
    }
   }
  }
 }
}