{
 "appid": 271590,
 "name": "Grand Theft Auto V (Legacy)",
 "notes": {
  "es": "Edita settings.xml y añade -ignoreDifferentVideoCard a commandline.txt (para que no reinicie la configuración al detectar la GPU). El modo historia funciona en Linux; GTA Online no (BattlEye). Si usas GTA V Enhanced, este perfil no le sirve.",
  "en": "Edits settings.xml and adds -ignoreDifferentVideoCard to commandline.txt (so settings aren't reset when the GPU is detected). Story mode works on Linux; GTA Online doesn't (BattlEye). Not valid for GTA V Enhanced."
 },
 "files": {
  "settings": {
   "path": "{documents}/Rockstar Games/GTA V/settings.xml",
   "type": "xml"
  },
  "cmdline": {
   "path": "{game}/commandline.txt",
   "type": "lines",
   "create": true
  }
 },
 "require": [
  "settings"
 ],
 "launch": {
  "fex": "fast",
  "ntsync": true
 },
 "resolution": {
  "type": "xml",
  "file": "settings",
  "width": "video/ScreenWidth",
  "height": "video/ScreenHeight",
  "choices": [
   "960x540",
   "1280x720",
   "1600x900",
   "1920x1080"
  ]
 },
