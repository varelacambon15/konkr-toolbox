{
 "match": {
  "glob": "{appdata_local}/*/Saved/Config/Windows*/Engine.ini"
 },
 "name": "Unreal Engine 4/5",
 "experimental": true,
 "notes": {
  "es": "Perfil genérico para juegos de Unreal Engine: añade variables [SystemSettings] a Engine.ini. Algunos juegos las ignoran. Si algo va mal, pulsa «Restaurar original».",
  "en": "Generic profile for Unreal Engine games: adds [SystemSettings] variables to Engine.ini. Some games ignore them. If anything goes wrong, press “Restore original”."
 },
 "files": {
  "engine": {
   "path": "Engine.ini",
   "type": "ini"
  },
  "gus": {
   "path": "GameUserSettings.ini",
   "type": "ini"
  }
 },
 "require": [
  "engine"
 ],
 "resolution": {
  "file": "gus",
  "section": "/Script/Engine.GameUserSettings",
  "width": [
   "ResolutionSizeX",
   "LastUserConfirmedResolutionSizeX"
  ],
  "height": [
   "ResolutionSizeY",
   "LastUserConfirmedResolutionSizeY"
  ],
  "choices": [
   "960x540",
   "1280x720",
   "1600x900",
   "1920x1080"
  ]
 },
 "presets": {
  "lowest": {
   "engine": {
    "SystemSettings": {
     "r.ViewDistanceScale": "0.6",
     "r.ShadowQuality": "1",
     "r.Shadow.MaxResolution": "512",
     "r.Shadow.DistanceScale": "0.6",
     "r.PostProcessAAQuality": "2",
     "r.MotionBlurQuality": "0",
     "r.DepthOfFieldQuality": "0",
     "r.BloomQuality": "1",
     "r.SSR.Quality": "0",
     "r.AmbientOcclusionLevels": "0",
     "r.VolumetricFog": "0",
     "r.LensFlareQuality": "0",
     "r.SceneColorFringeQuality": "0",
     "foliage.DensityScale": "0.5",
     "grass.DensityScale": "0.5",
     "r.MaxAnisotropy": "4",
     "r.DetailMode": "0"
    }
   }
  },
  "balanced": {
   "engine": {
    "SystemSettings": {
     "r.ViewDistanceScale": "0.8",
     "r.ShadowQuality": "2",
     "r.Shadow.MaxResolution": "1024",
     "r.Shadow.DistanceScale": "0.8",
     "r.PostProcessAAQuality": "3",
     "r.MotionBlurQuality": "0",
     "r.DepthOfFieldQuality": "1",
     "r.BloomQuality": "2",
     "r.SSR.Quality": "1",
     "r.AmbientOcclusionLevels": "1",
     "r.VolumetricFog": "0",
     "r.LensFlareQuality": "1",
     "r.SceneColorFringeQuality": "0",
     "foliage.DensityScale": "0.75",
     "grass.DensityScale": "0.75",
     "r.MaxAnisotropy": "4",
     "r.DetailMode": "1"
    }
   }
  }
 },
 "launch": {
  "fex": "fast",
  "ntsync": true
 }
}